---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import Subscribe from '../components/Subscribe.astro';
import { SITE } from '../consts';
import { getPublishedPosts, groupBySeries } from '../utils/posts';

const posts = await getPublishedPosts();
const { rounds, loose } = groupBySeries(posts);

// Posts are grouped into round sections (newest round first). Within a round
// they read top to bottom, 01 → NN, with the first marked "Start here".
// Any posts without a series fall into a "More" section.
const hasRounds = rounds.length > 0;
const n = (count: number) => `${count} ${count === 1 ? 'post' : 'posts'}`;
---

<BaseLayout title={SITE.author}>
  <section class="intro">
    <p>
      I'm building small games solo, leaning hard on AI for code, art, and
      everything in between. This is the honest log: what I shipped, what
      worked, what failed, and what I'd do differently.
    </p>
    <p>
      Each round is a short series of posts. New rounds get added as I keep
      going. Browse by tag, or just read top to bottom.
    </p>
  </section>

  {
    hasRounds ? (
      <>
        {rounds.map((round) => (
          <section class="round">
            <header class="round-head">
              <div class="round-head-row">
                <h2 class="round-title">{round.title}</h2>
                <span class="round-count">{n(round.posts.length)}</span>
              </div>
              {round.description && <p class="round-desc">{round.description}</p>}
            </header>
            <PostList posts={round.posts} startHereSlug={round.posts[0]?.slug} />
          </section>
        ))}
        {loose.length > 0 && (
          <section class="round">
            <header class="round-head">
              <div class="round-head-row">
                <h2 class="round-title">More</h2>
                <span class="round-count">{n(loose.length)}</span>
              </div>
            </header>
            <PostList posts={loose} />
          </section>
        )}
      </>
    ) : (
      <>
        <p class="section-label">Posts</p>
        <PostList posts={posts} />
      </>
    )
  }

  <Subscribe />
</BaseLayout>
