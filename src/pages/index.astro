---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { SITE } from '../consts';
import { getPublishedPosts, groupBySeries } from '../utils/posts';

const posts = await getPublishedPosts();
const { rounds, loose } = groupBySeries(posts);

// Group into round sections only once there's more than one round; with a
// single round (or just loose posts) the home stays a clean flat list.
const grouped = rounds.length > 1;
---

<BaseLayout title={SITE.name}>
  <section class="intro">
    <p>
      I'm building small games solo, leaning hard on AI for code, art, and
      everything in between. This is the honest log: what I shipped, what
      worked, what failed, and what I'd do differently.
    </p>
    <p>
      Each round is a short series of posts. New rounds get added as I keep
      going. Browse by tag, or just read top to bottom.
    </p>
  </section>

  {
    grouped ? (
      <>
        {rounds.map((round) => (
          <section class="round">
            <h2 class="round-title">{round.title}</h2>
            <PostList posts={round.posts} startHereSlug={round.posts[0]?.slug} />
          </section>
        ))}
        {loose.length > 0 && (
          <section class="round">
            <h2 class="round-title">More</h2>
            <PostList posts={loose} />
          </section>
        )}
      </>
    ) : (
      <>
        <p class="section-label">Posts</p>
        <PostList posts={posts} />
      </>
    )
  }
</BaseLayout>
