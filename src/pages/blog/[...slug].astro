---
import { getCollection } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getSeriesNeighbors } from '../../utils/posts';

export async function getStaticPaths() {
  // Draft pages render in dev only; excluded from production builds.
  const posts = (await getCollection('blog')).filter(
    (p) => import.meta.env.DEV || !p.data.draft
  );
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await post.render();
const { title, description, pubDate, tags, draft } = post.data;

const minutesRead = remarkPluginFrontmatter.minutesRead as number | undefined;
const { prev, next, startHere, title: seriesName } =
  await getSeriesNeighbors(post);

// Social card image generated per-post by the /og route.
const ogImage = `/og/${post.slug}.png`;
---

<PostLayout
  title={title}
  description={description}
  pubDate={pubDate}
  tags={tags}
  draft={draft}
  minutesRead={minutesRead}
  seriesName={seriesName}
  prev={prev}
  next={next}
  startHere={startHere}
  ogImage={ogImage}
>
  <Content />
</PostLayout>
