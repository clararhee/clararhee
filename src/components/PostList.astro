---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
  /** Slug to flag with a "Start here" marker (the first post of a round). */
  startHereSlug?: string;
}

const { posts, startHereSlug } = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li class={post.data.draft ? 'is-draft' : undefined}>
        <a class="title" href={`/blog/${post.slug}/`}>
          {post.data.title}
          {post.slug === startHereSlug && <span class="start-here">Start here</span>}
          {post.data.draft && <span class="draft-badge">draft</span>}
        </a>
        <time class="date" datetime={post.data.pubDate.toISOString()}>
          {fmt(post.data.pubDate)}
        </time>
        <p class="desc">{post.data.description}</p>
      </li>
    ))
  }
</ul>
