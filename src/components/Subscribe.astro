---
import { SITE } from '../consts';
// Renders only when SITE.substack is set — a clean link, no heavy iframe.
---

{
  SITE.substack && (
    <aside class="subscribe">
      <p class="subscribe-copy">New posts by email, no spam.</p>
      <a
        class="subscribe-btn"
        href={SITE.substack}
        target="_blank"
        rel="noopener"
      >
        Subscribe
      </a>
    </aside>
  )
}
