---
import { NEWSLETTER_USER } from '../consts';
// Renders only when NEWSLETTER_USER is set. Native form POST to Buttondown
// (no JS, no popups). Clara exports the list / sends broadcasts manually.
---

{
  NEWSLETTER_USER && (
    <aside class="subscribe">
      <p>New posts as I keep building. No spam, unsubscribe anytime.</p>
      <form
        class="subscribe-form"
        action={`https://buttondown.com/api/emails/embed-subscribe/${NEWSLETTER_USER}`}
        method="post"
        target="_blank"
      >
        <input type="email" name="email" placeholder="you@email.com" required />
        <button type="submit">Subscribe</button>
      </form>
    </aside>
  )
}
