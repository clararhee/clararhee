---
import Nav from '../components/Nav.astro';
// Self-hosted fonts — no external Google Fonts requests.
import '@fontsource/spectral/400.css';
import '@fontsource/spectral/400-italic.css';
import '@fontsource/spectral/600.css';
import '@fontsource/spectral/700.css';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Optional override for og:type, defaults to 'website'. */
  ogType?: string;
}

const {
  title,
  description = 'Building games solo with AI — a running log of what worked and what broke.',
  ogType = 'website',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const siteName = 'DevLog';
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
const year = new Date().getFullYear();

// GoatCounter analytics (privacy-friendly, no cookies, ~3.5KB).
// Set this to your site code after signing up at https://www.goatcounter.com/
// e.g. 'clararhee' for a clararhee.goatcounter.com dashboard.
// Left empty → no script is emitted. Only loads in production builds, so local
// `astro dev` visits are never counted.
const GOATCOUNTER_CODE = 'yrhee4';
const analyticsOn = GOATCOUNTER_CODE && import.meta.env.PROD;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteName}
      href={new URL('rss.xml', Astro.site)}
    />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <div class="wrap">
      <Nav />
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <p>&copy; {year} DevLog · <a href="/rss.xml">RSS</a></p>
      </footer>
    </div>
    {
      analyticsOn && (
        <script
          data-goatcounter={`https://${GOATCOUNTER_CODE}.goatcounter.com/count`}
          async
          src="//gc.zgo.at/count.js"
        />
      )
    }
  </body>
</html>
